rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /stages/{stageId} {
      allow read: if true;
      allow create, update: if isAdmin() && stageId in ['1','2','3'] && request.resource.data.keys().hasOnly(['id','name','time','status','current','events']) && request.resource.data.id == stageId && request.resource.data.status in ['upcoming','running','done'] && request.resource.data.events is list && request.resource.data.events.size() <= 100;
      allow delete: if false;
    }
    match /settings/announcements {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['items','updatedAt']) && request.resource.data.items is list && request.resource.data.items.size() <= 30;
    }
    match /results/{resultId} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['stage','event','winner','place','createdAt']) && request.resource.data.stage in ['1','2','3'] && request.resource.data.event is string && request.resource.data.winner is string && request.resource.data.place is string;
      allow update, delete: if false;
    }
  }
}
